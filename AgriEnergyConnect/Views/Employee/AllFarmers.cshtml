@model IEnumerable<AgriEnergyConnect.Models.Farmer>

@{
    ViewData["Title"] = "All Farmers";
}

<h2>All Farmers</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Region</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var farmer in Model)
        {
            <tr>
                <td>@farmer.FullName</td>
                <td>@farmer.Region</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="ViewProducts" asp-route-farmerId="@farmer.Id">View Products</a>
                </td>
            </tr>
        }
    </tbody>
</table>
